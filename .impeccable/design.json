      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid rgb(var(--surface-700, 188 196 177));border-radius:6px;background:rgb(var(--surface-900, 252 250 245));color:rgb(var(--surface-200, 49 60 50));font-family:\"Source Sans 3\",system-ui,-apple-system,sans-serif;font-size:16px;line-height:24px;font-weight:500;cursor:pointer;transition:color 150ms cubic-bezier(0.4,0,0.2,1),background-color 150ms cubic-bezier(0.4,0,0.2,1);}.ds-button-secondary:hover{background:rgb(var(--surface-800, 221 224 210));}.ds-button-secondary:focus-visible{outline:2px solid rgb(var(--primary-500, 39 75 62));outline-offset:3px;border-radius:3px;}.ds-button-secondary:disabled{opacity:0.5;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition-duration:0.001ms!important;animation:none!important}}"
    },
