      "refersTo": "input",
      "description": "A labelled field with a visible focus ring.",
      "html": "<label class=\"ds-field-label\" for=\"ds-item-name\">Name</label><input class=\"ds-input\" id=\"ds-item-name\" value=\"Coffee grinder\" />",
      "css": ".ds-field-label{display:block;margin-bottom:8px;color:rgb(var(--surface-300, 71 81 70));font-family:\"Source Sans 3\",system-ui,-apple-system,sans-serif;font-size:14px;line-height:20px;font-weight:500;}.ds-input{width:100%;min-height:44px;padding:10px 14px;border:1px solid rgb(var(--surface-700, 188 196 177));border-radius:6px;background:rgb(var(--surface-900, 252 250 245));color:rgb(var(--surface-100, 31 40 33));font-family:\"Source Sans 3\",system-ui,-apple-system,sans-serif;font-size:16px;line-height:24px;transition:border-color 150ms cubic-bezier(0.4,0,0.2,1);}.ds-input:focus-visible{outline:none;border-color:rgb(var(--primary-500, 39 75 62));box-shadow:0 0 0 1px rgb(var(--primary-500, 39 75 62));}.ds-input:disabled{opacity:0.55;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition-duration:0.001ms!important;animation:none!important}}"
    },
    {
      "name": "Sidebar navigation",
      "kind": "nav",
      "refersTo": "sidebar-link",
      "description": "Written navigation on the persistent forest surface.",
      "html": "<nav class=\"ds-sidebar\" aria-label=\"Catalogue navigation\"><a class=\"ds-sidebar-link\" href=\"#catalogue\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\"/></svg>Catalogue</a></nav>",
      "css": ".ds-sidebar{padding:12px;background:rgb(var(--sidebar, 35 68 54));}.ds-sidebar-link{display:flex;align-items:center;gap:12px;padding:12px;border-radius:6px;text-decoration:none;color:rgb(var(--sidebar-text, 246 244 234));font-family:\"Source Sans 3\",system-ui,-apple-system,sans-serif;font-size:16px;line-height:24px;transition:background-color 150ms cubic-bezier(0.4,0,0.2,1);}.ds-sidebar-link:hover,.ds-sidebar-link[aria-current=\"page\"]{background:rgb(var(--sidebar-selected, 74 103 80));}.ds-sidebar-link:focus-visible{outline:2px solid rgb(var(--sidebar-text, 246 244 234));outline-offset:3px;}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition-duration:0.001ms!important;animation:none!important}}"
    },
