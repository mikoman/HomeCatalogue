  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action on a page or review footer.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Scan a space</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:0;border-radius:6px;background:rgb(var(--primary-500, 39 75 62));color:rgb(var(--surface-950, 245 242 235));font-family:\"Source Sans 3\",system-ui,-apple-system,sans-serif;font-size:16px;line-height:24px;font-weight:600;cursor:pointer;transition:color 150ms cubic-bezier(0.4,0,0.2,1),background-color 150ms cubic-bezier(0.4,0,0.2,1);}.ds-button-primary:hover{background:rgb(var(--primary-400, 30 66 52));}.ds-button-primary:focus-visible{outline:2px solid rgb(var(--primary-500, 39 75 62));outline-offset:3px;border-radius:3px;}.ds-button-primary:disabled{opacity:0.5;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition-duration:0.001ms!important;animation:none!important}}"
    },
