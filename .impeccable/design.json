      "refersTo": "location-tab",
      "description": "A flat room filter with a selected underline.",
      "html": "<div class=\"ds-tabs\" aria-label=\"Filter items\"><button type=\"button\" class=\"ds-tab\" aria-pressed=\"true\">All items</button><button type=\"button\" class=\"ds-tab\" aria-pressed=\"false\">Coffee shelf</button></div>",
      "css": ".ds-tabs{display:flex;gap:8px;border-bottom:1px solid rgb(var(--surface-800, 221 224 210));}.ds-tab{min-height:44px;padding:8px 12px;border:0;border-bottom:2px solid transparent;background:transparent;color:rgb(var(--surface-400, 91 101 87));font-family:\"Source Sans 3\",system-ui,-apple-system,sans-serif;font-size:14px;line-height:20px;white-space:nowrap;cursor:pointer;}.ds-tab[aria-pressed=\"true\"]{color:rgb(var(--primary-400, 30 66 52));border-bottom-color:rgb(var(--primary-500, 39 75 62));font-weight:600;}.ds-tab:hover{color:rgb(var(--primary-400, 30 66 52));}.ds-tab:focus-visible{outline:2px solid rgb(var(--primary-500, 39 75 62));outline-offset:3px;border-radius:3px;}"
