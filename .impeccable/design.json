      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-title\">Containers</h2><p class=\"ds-card-copy\">Choose where to keep an item.</p></section>",
      "css": ".ds-card{min-width:0;max-width:100%;padding:16px;border:1px solid rgb(var(--surface-800, 221 224 210));border-radius:8px;background:rgb(var(--surface-900, 252 250 245));color:rgb(var(--surface-300, 71 81 70));}.ds-card-title{margin:0 0 8px;font-family:Lora,Georgia,serif;font-size:18px;font-weight:400;line-height:28px;color:rgb(var(--surface-100, 31 40 33));}.ds-card-copy{margin:0;font-family:\"Source Sans 3\",system-ui,-apple-system,sans-serif;font-size:16px;line-height:24px;}"
    },
    {
      "name": "Theme switch",
      "kind": "custom",
      "refersTo": "theme-toggle",
      "description": "The shared light and dark control, including inside review.",
      "html": "<button type=\"button\" class=\"ds-theme\" role=\"switch\" aria-checked=\"false\" aria-label=\"Dark mode\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4L19 5\"/></svg><span>Dark mode</span><span class=\"ds-track\" aria-hidden=\"true\"><span class=\"ds-thumb\"></span></span></button>",
      "css": ".ds-theme{display:flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 8px;border:0;border-radius:6px;background:transparent;color:rgb(var(--surface-300, 71 81 70));font-family:\"Source Sans 3\",system-ui,-apple-system,sans-serif;font-size:14px;line-height:20px;cursor:pointer;}.ds-theme:hover{background:rgb(var(--surface-800, 221 224 210));}.ds-theme:focus-visible{outline:2px solid rgb(var(--primary-500, 39 75 62));outline-offset:3px;border-radius:3px;}.ds-track{position:relative;display:block;width:36px;height:20px;border-radius:9999px;background:rgb(var(--surface-700, 188 196 177));}.ds-thumb{position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:9999px;background:rgb(var(--surface-900, 252 250 245));transition:transform 150ms ease-out;}.ds-theme[aria-checked=\"true\"] .ds-track{background:rgb(var(--primary-500, 39 75 62));}.ds-theme[aria-checked=\"true\"] .ds-thumb{transform:translateX(16px);}@media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition-duration:0.001ms!important;animation:none!important}}"
    },
    {
      "name": "Open item caption",
      "kind": "custom",
      "description": "A gallery caption with its name and written storage location.",
      "html": "<article class=\"ds-item\"><button type=\"button\" class=\"ds-item-open\" aria-label=\"Open Coffee grinder\"><span class=\"ds-item-title\">Coffee grinder</span><span class=\"ds-item-meta\">Coffee</span><span class=\"ds-item-meta\">In: Coffee shelf</span></button></article>",
      "css": ".ds-item{min-width:0;}.ds-item-open{display:block;width:100%;padding:12px 0 0;text-align:left;border:0;border-radius:2px;background:transparent;cursor:pointer;}.ds-item-title{display:block;font-family:Lora,Georgia,serif;font-size:18px;font-weight:500;line-height:1.375;color:rgb(var(--surface-100, 31 40 33));overflow-wrap:break-word;}.ds-item-meta{display:block;margin-top:4px;font-family:\"Source Sans 3\",system-ui,-apple-system,sans-serif;font-size:14px;line-height:20px;color:rgb(var(--surface-400, 91 101 87));overflow-wrap:break-word;}.ds-item-open:hover .ds-item-title{color:rgb(var(--primary-400, 30 66 52));}.ds-item-open:focus-visible{outline:2px solid rgb(var(--primary-500, 39 75 62));outline-offset:3px;border-radius:3px;}"
    }
  ],
  "narrative": {
    "northStar": "Folio: a personal editorial archive",
    "overview": "Folio makes household photographs and storage locations the main content. Warm ivory, forest green, serif headings, and open galleries give the collection a clear reading order. Fine dividers separate controls without enclosing every object.\n\nDark mode preserves the same composition. Deep green replaces the ivory canvas, while warm text and pale sage controls retain the hierarchy. Phone scanning and desktop browsing share the same visual system.",
    "keyCharacteristics": [
      "Open photo galleries with names and written storage locations.",
      "Lora headings paired with Source Sans 3 controls.",
      "Flat surfaces, fine dividers, and small corner radii.",
      "One shared theme choice across navigation, Settings, and scan review."
    ],
    "rules": [
      {
        "name": "The Shared Theme Rule",
        "body": "Use the shared theme variables on every surface, including modal review.",
        "section": "colors"
      },
      {
        "name": "The Photo Proportion Rule",
        "body": "Preserve object proportions when a gallery or review frame crops the source photograph.",
        "section": "components"
      },
      {
        "name": "The Visible Location Rule",
        "body": "Keep each item’s storage location beside its name or editable name field.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the shared theme variables and local font files.",
      "Do show object photographs with written locations.",
      "Do preserve keyboard focus, touch targets, and reduced-motion support.",
      "Do keep status text visible beside its related action.",
      "Do retain review controls for uncertain items and missing destinations."
    ],
    "donts": [
      "Don't stretch objects to fill gallery or review frames.",
      "Don't use generated concept photographs as catalogue records.",
      "Don't add decorative grids, gradients, or button glows to Folio.",
      "Don't identify active providers or review warnings through color alone.",
      "Don't present synthetic browser checks as proof of physical camera capture or backend persistence."
    ]
  }
}
