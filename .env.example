# AI Vision Model Configuration
# Choose one: openai, anthropic, openrouter, ollama, lmstudio, omlx
AI_PROVIDER=ollama

# OpenRouter (optional cloud inference; keep the real key on the backend)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# Ollama context and output limits for 32 GB machines
OLLAMA_NUM_CTX=8192
SCAN_MAX_TOKENS=4096
SCAN_MAX_EDGE=1280

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Ollama (local — use host.docker.internal when backend runs in Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b

# LM Studio (local, OpenAI-compatible API)
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_MODEL=

# oMLX (local, Apple Silicon)
# Choose a vision-capable MLX model supported by your installed server.
# Use the actual model ID from that server's /v1/models response.
OMLX_MODEL=

# Server
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:////app/storage/home_catalogue.db
UPLOAD_DIR=/app/storage/uploads
AI_SETTINGS_FILE=/app/storage/ai_settings.json
RUNNING_IN_DOCKER=1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
